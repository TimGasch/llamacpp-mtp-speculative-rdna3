From 5ac76109184105add601a5aa6424cd84bdfafeee Mon Sep 17 00:00:00 2001
From: Fast llama project <noreply@anthropic.com>
Date: Wed, 30 Sep 2026 20:45:43 +0200
Subject: [PATCH] vulkan: MMVQ decode-once for Q4_K/Q5_K/Q6_K (bit-identical)

In mul_mat_vecq the A-block unpacking (repack4 + scale decode) was executed once per
B column, so its cost scaled with NUM_COLS and batched mat-vec (speculative verification,
n=2..8) became ALU-bound on RDNA3. Decode each A block once per row and dot it against
all cached B columns. Same integer dot products and float expressions in the same order,
so results are bit-identical to the original path.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../vulkan-shaders/mul_mat_vecq.comp          | 32 +++++++++++++++
 .../vulkan-shaders/mul_mat_vecq_funcs.glsl    | 39 +++++++++++++++++++
 2 files changed, 71 insertions(+)

diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq.comp b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq.comp
index 3383aa8..32a0292 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq.comp
@@ -29,6 +29,37 @@ vec2 cache_b_ds;
 
 #include "mul_mat_vecq_funcs.glsl"
 
+#if defined(MMVQ_DECODE_ONCE) && K_PER_ITER == 16 && QUANT_R != 2
+// Decode each A block once per row, then dot it against every B column. Same arithmetic and
+// accumulation order as the per-column path below (bit-identical results), but the A-side
+// unpacking no longer scales with NUM_COLS (matters for batched/speculative verification).
+void iter(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], const uint first_row, const uint num_rows, const uint col, const uint b_qs_idx) {
+    i32vec4 qs_a[NUM_ROWS];
+    vec2 sc_a[NUM_ROWS];
+
+    uint ibi = first_row*p.ncols;
+    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
+        const uint a_block_idx = (ibi + col)/QUANT_K_Q8_1 + a_offset;
+        ibi += p.ncols;
+        mmvq_decode_a(a_block_idx, b_qs_idx, qs_a[n], sc_a[n]);
+    }
+
+    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
+        const uint b_block_idx = (j*p.batch_stride_b + col) / QUANT_K_Q8_1 + b_offset;
+        const uint b_block_idx_outer = b_block_idx / 4;
+        const uint b_block_idx_inner = b_block_idx % 4;
+        cache_b_ds = vec2(data_b[b_block_idx_outer].ds[b_block_idx_inner]);
+        cache_b_qs[0] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 4    ];
+        cache_b_qs[1] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 4 + 1];
+        cache_b_qs[2] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 4 + 2];
+        cache_b_qs[3] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 4 + 3];
+
+        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
+            temp[j][n] += mmvq_dot_decoded(qs_a[n], sc_a[n]);
+        }
+    }
+}
+#else
 void iter(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], const uint first_row, const uint num_rows, const uint col, const uint b_qs_idx) {
     [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
         // Preload data_b block
@@ -73,6 +104,7 @@ void iter(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], const uint first_row, const
         }
     }
 }
+#endif
 
 void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
     const uint tid = gl_LocalInvocationID.x;
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq_funcs.glsl b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq_funcs.glsl
index 03c348b..2974533 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq_funcs.glsl
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq_funcs.glsl
@@ -378,6 +378,27 @@ FLOAT_TYPE mmvq_dot_product(const uint ib_a, const uint iqs) {
 
     return FLOAT_TYPE(float(cache_b_ds.x) * float(dm_scale.x) * float(q_sum) - float(dm_scale.y) * float(cache_b_ds.y / 2));
 }
+
+// Decode-once variant: split mmvq_dot_product into an A-side decode (done once per row and
+// K-iteration) and a cheap dot against the currently cached B column. The arithmetic is exactly
+// the same as mmvq_dot_product, so results are bit-identical; with NUM_COLS > 1 it avoids
+// repeating the nibble/scale unpacking of the same A block for every column.
+#define MMVQ_DECODE_ONCE
+void mmvq_decode_a(const uint ib_a, const uint iqs, out i32vec4 qs_a, out vec2 sc_a) {
+    qs_a = repack4(ib_a, iqs * 4);
+    sc_a = get_dm_scale(ib_a, iqs * 4);
+}
+
+FLOAT_TYPE mmvq_dot_decoded(const i32vec4 qs_a, const vec2 dm_scale) {
+    int32_t q_sum = 0;
+
+    q_sum += dotPacked4x8EXT(qs_a.x, cache_b_qs[0]);
+    q_sum += dotPacked4x8EXT(qs_a.y, cache_b_qs[1]);
+    q_sum += dotPacked4x8EXT(qs_a.z, cache_b_qs[2]);
+    q_sum += dotPacked4x8EXT(qs_a.w, cache_b_qs[3]);
+
+    return FLOAT_TYPE(float(cache_b_ds.x) * float(dm_scale.x) * float(q_sum) - float(dm_scale.y) * float(cache_b_ds.y / 2));
+}
 #endif
 
 #if defined(DATA_A_Q6_K)
@@ -446,6 +467,24 @@ FLOAT_TYPE mmvq_dot_product(const uint ib_a, const uint iqs) {
 
     return FLOAT_TYPE(float(cache_b_ds.x) * float(d_scale) * float(q_sum));
 }
+
+// Decode-once variant (see the Q4_K/Q5_K block above); bit-identical to mmvq_dot_product.
+#define MMVQ_DECODE_ONCE
+void mmvq_decode_a(const uint ib_a, const uint iqs, out i32vec4 qs_a, out vec2 sc_a) {
+    qs_a = repack4(ib_a, iqs * 4);
+    sc_a = vec2(get_d_scale(ib_a, iqs * 4), 0.0f);
+}
+
+FLOAT_TYPE mmvq_dot_decoded(const i32vec4 qs_a, const vec2 sc_a) {
+    int32_t q_sum = 0;
+
+    q_sum += dotPacked4x8EXT(qs_a.x, cache_b_qs[0]);
+    q_sum += dotPacked4x8EXT(qs_a.y, cache_b_qs[1]);
+    q_sum += dotPacked4x8EXT(qs_a.z, cache_b_qs[2]);
+    q_sum += dotPacked4x8EXT(qs_a.w, cache_b_qs[3]);
+
+    return FLOAT_TYPE(float(cache_b_ds.x) * float(sc_a.x) * float(q_sum));
+}
 #endif
 
 #if defined(DATA_A_IQ4_XS)
