+// fastllama diagnostics (diag-host branch only): host time of small decode calls, per stage.
+// slot 0 = target context (unmasked nextn), slot 1 = MTP draft context (masked nextn)
+struct fl_ctx_diag_t {
+    int64_t t[8] = {0};
+    int64_t n    = 0;
+    int64_t n_reuse = 0;
+};
+static fl_ctx_diag_t g_fl_ctx[2];
+static thread_local int g_fl_which = -1; // -1 = not timed
+static thread_local int64_t g_fl_t_last = 0;
+static void fl_mark(int stage) {
+    if (g_fl_which < 0) {
+        return;
+    }
+    const int64_t now = ggml_time_us();
+    g_fl_ctx[g_fl_which].t[stage] += now - g_fl_t_last;
+    g_fl_t_last = now;
+}
+static void fl_ctx_report(int which) {
+    auto & d = g_fl_ctx[which];
+    if (++d.n % 400 != 0) {
+        return;
+    }
+    static const char * names[8] = {"init", "apply", "build", "inputs", "compute", "extract", "finish", "-"};
+    fprintf(stderr, "fl_ctx %s n=%" PRId64 " reuse=%" PRId64, which == 0 ? "tgt" : "dft", d.n, d.n_reuse);
+    for (int i = 0; i < 7; ++i) {
+        fprintf(stderr, " %s=%.3f", names[i], d.t[i] / 1000.0 / d.n);
+    }
+    fprintf(stderr, " (ms/call)\n");
+    fflush(stderr);
+    d = fl_ctx_diag_t{};
+}
