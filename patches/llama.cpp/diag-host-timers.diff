diff --git a/common/fl_diag.h b/common/fl_diag.h
new file mode 100644
index 0000000..db7dcc4
--- /dev/null
+++ b/common/fl_diag.h
@@ -0,0 +1,66 @@
+// fastllama diagnostics (diag-host branch only, never part of a candidate build):
+// wall-clock timers around the host-side parts of one speculative step.
+#pragma once
+
+#include "ggml.h"
+
+#include <cinttypes>
+#include <cstdint>
+#include <cstdio>
+
+enum fl_diag_id {
+    FLD_ITER,          // update_slots() iterations that verified a draft
+    FLD_DRAFT_YIELD,   // yield_to_queue around common_speculative_draft
+    FLD_DRAFT_PROC,    // llama_process(ctx_dft) inside draft()
+    FLD_DRAFT_SAMPLE,  // draft sampler (includes the wait for the draft graph)
+    FLD_DRAFT_REST,    // post-draft bookkeeping (checkpoints, batch building)
+    FLD_DEC_YIELD,     // yield_to_queue around the target decode
+    FLD_DEC_PROC,      // llama_process(ctx_tgt) (host: graph build, schedule, record, submit)
+    FLD_DEC_SYNC,      // llama_synchronize(ctx_tgt) (wait for the GPU)
+    FLD_SPEC_YIELD,    // yield_to_queue around common_speculative_process
+    FLD_SPEC_PROC,     // common_speculative_process (MTP hook)
+    FLD_SPEC_PROC_DEC, // llama_process(ctx_dft) inside process()
+    FLD_SMPL_CLONE,    // common_sampler_clone of the slot sampler
+    FLD_SAMPLE,        // common_sampler_sample_and_accept_n
+    FLD_POST,          // accept bookkeeping + sending the tokens
+    FLD_COUNT,
+};
+
+struct fl_diag_slot {
+    const char * name;
+    int64_t t;
+    int64_t n;
+};
+
+inline fl_diag_slot g_fl_diag[FLD_COUNT] = {
+    {"iter", 0, 0},        {"draft_yield", 0, 0}, {"draft_proc", 0, 0},     {"draft_sample", 0, 0},
+    {"draft_rest", 0, 0},  {"dec_yield", 0, 0},   {"dec_proc", 0, 0},       {"dec_sync", 0, 0},
+    {"spec_yield", 0, 0},  {"spec_proc", 0, 0},   {"spec_proc_dec", 0, 0},  {"smpl_clone", 0, 0},
+    {"sample", 0, 0},      {"post", 0, 0},
+};
+
+inline bool g_fl_diag_on = true;
+
+struct fl_timer {
+    int     id;
+    bool    on;
+    int64_t t0;
+    explicit fl_timer(int id_, bool on_ = true) : id(id_), on(on_), t0(ggml_time_us()) {}
+    ~fl_timer() {
+        if (g_fl_diag_on && on) {
+            g_fl_diag[id].t += ggml_time_us() - t0;
+            g_fl_diag[id].n += 1;
+        }
+    }
+};
+
+inline void fl_diag_print_reset() {
+    for (auto & s : g_fl_diag) {
+        if (s.n > 0) {
+            fprintf(stderr, "fl_diag %-14s n=%6" PRId64 " avg=%8.3f ms total=%10.1f ms\n", s.name, s.n, s.t / 1000.0 / s.n, s.t / 1000.0);
+        }
+        s.t = 0;
+        s.n = 0;
+    }
+    fflush(stderr);
+}
