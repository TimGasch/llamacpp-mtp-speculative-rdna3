     if (mctx && !mctx->apply()) {
         LLAMA_LOG_ERROR("%s: failed to apply memory context\n", __func__);
         ret = GGML_STATUS_FAILED;
         return nullptr;
     }
 
+    fl_mark(1);
     auto * res = get_gf_res_prev();
     auto * gf  = res->get_gf();
 
@@ -1415,6 +1450,9 @@ llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, ll
         }
 
         n_reused++;
+        if (g_fl_which >= 0) {
+            g_fl_ctx[g_fl_which].n_reuse++;
+        }
     } else {
         gf_res_prev_active = nullptr;
         res->reset();
@@ -1443,6 +1481,7 @@ llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, ll
         gf_res_prev_active = res;
     }
 
+    fl_mark(2);
     // set the input data for the input tensors
     {
         //const auto t_start_us = ggml_time_us();
@@ -1452,8 +1491,10 @@ llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, ll
 
         //LLAMA_LOG_INFO("graph set inputs time: %.3f ms\n", (ggml_time_us() - t_start_us)/1000.0);
     }
+    fl_mark(3);
 
     const auto status = graph_compute(res->get_gf(), ubatch.n_tokens > 1);
+    fl_mark(4);
     if (status != GGML_STATUS_SUCCESS) {
         LLAMA_LOG_ERROR("%s: failed to compute graph, compute status: %d\n", __func__, status);
         ret = status;
@@ -1715,6 +1756,9 @@ int llama_context::decode(const llama_batch_ext & batch_inp) {
         return -1;
     }
 
+    g_fl_which  = batch_inp.tokens.size() <= 8 ? (cparams.embeddings_nextn_masked ? 1 : 0) : -1;
+    g_fl_t_last = ggml_time_us();
+
     if (batch_inp.n_embd > 0 && batch_inp.n_embd != batch_inp.n_embd_inp) {
         LLAMA_LOG_ERROR("%s: embd row width %zu does not match the decoder input %zu\n",
                 __func__, batch_inp.n_embd, batch_inp.n_embd_inp);
@@ -2036,6 +2080,7 @@ int llama_context::decode(const llama_batch_ext & batch_inp) {
 
         n_outputs_prev += n_outputs;
         n_tokens_prev  += ubatch.n_tokens;
+        fl_mark(5);
     } while (mctx->next());
 
     // set to total number of outputs in the batch, for use in llama_get_logits_ith
@@ -2091,6 +2136,12 @@ int llama_context::decode(const llama_batch_ext & batch_inp) {
     // wait for the computation to finish (automatically done when obtaining the model output)
     //synchronize();
 
+    if (g_fl_which >= 0) {
+        fl_mark(6);
+        fl_ctx_report(g_fl_which);
+        g_fl_which = -1;
