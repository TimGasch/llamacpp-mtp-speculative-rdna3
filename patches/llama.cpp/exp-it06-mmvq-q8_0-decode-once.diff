+#if defined(DATA_A_Q8_0)
+// Decode-once variant for Q8_0 (see the K-quant blocks below): the A loads/packing are done once
+// per row and reused for every B column. Bit-identical to mmvq_dot_product.
+#define MMVQ_DECODE_ONCE
+void mmvq_decode_a(const uint ib_a, const uint iqs, out i32vec4 qs_a, out vec2 sc_a) {
+    qs_a = i32vec4(repack(ib_a, iqs * 2), repack(ib_a, iqs * 2 + 1), 0, 0);
+    sc_a = vec2(get_dm(ib_a), 0.0f);
+}
+
+FLOAT_TYPE mmvq_dot_decoded(const i32vec4 qs_a, const vec2 sc_a) {
+    int32_t q_sum = 0;
+    q_sum += dotPacked4x8EXT(qs_a.x, cache_b_qs[0]);
+    q_sum += dotPacked4x8EXT(qs_a.y, cache_b_qs[1]);
+    return mul_q8_1(q_sum, sc_a.x, cache_b_ds, 4);
